{
  "name": "@dmfaster/product-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./analytics": "./src/analytics.tsx",
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./globals.css": "./src/styles/globals.css",
    "./hooks/*": "./src/components/hooks/*.ts",
    "./company-signals": "./src/company-signals.tsx",
    "./company-technologies": "./src/company-technologies.ts",
    "./company-brands": "./src/company-brands.tsx",
    "./decision-maker-roles": "./src/decision-maker-roles.ts"
  },
  "scripts": {
    "typecheck": "node ../../tools/typecheck-release.mjs --project tsconfig.json",
    "lint": "oxlint -c ../../.oxlintrc.json src",
    "check": "pnpm lint && pnpm typecheck",
    "typecheck:local": "node ../../tools/typecheck-local.mjs --project tsconfig.json",
    "check:local": "pnpm lint && pnpm typecheck:local"
  },
  "peerDependencies": {
    "react": ">=19.2.0",
    "react-dom": ">=19.2.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@shadcn/react": "0.3.1",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.4.0",
    "lucide-react": "1.27.0",
    "tw-animate-css": "1.4.0"
  }
}
