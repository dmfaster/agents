{
  "name": "@dmfaster/cli",
  "version": "2.4.0",
  "description": "Command-line interface for DM Faster Agent 1.0.",
  "license": "Apache-2.0",
  "author": "DM Faster",
  "homepage": "https://dmfaster.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmfaster/agents.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "bin": {
    "dmfaster": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node ../../tools/typecheck-release.mjs --emit --project tsconfig.json",
    "typecheck": "node ../../tools/typecheck-release.mjs --project tsconfig.json",
    "test": "node --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "typecheck:local": "node ../../tools/typecheck-local.mjs --project tsconfig.json"
  },
  "dependencies": {
    "@dmfaster/local-auth": "2.4.0",
    "@dmfaster/sdk": "2.4.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3"
  }
}
