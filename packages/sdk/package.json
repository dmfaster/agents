{
  "name": "@dmfaster/sdk",
  "version": "2.5.1",
  "description": "Typed client for the DM Faster Agent API.",
  "license": "Apache-2.0",
  "author": "DM Faster",
  "homepage": "https://dmfaster.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmfaster/agents.git",
    "directory": "packages/sdk"
  },
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./instagram-prospecting": {
      "types": "./dist/instagram-prospecting.d.ts",
      "import": "./dist/instagram-prospecting.js",
      "default": "./dist/instagram-prospecting.js"
    },
    "./instagram-calibration": {
      "types": "./dist/instagram-calibration.d.ts",
      "import": "./dist/instagram-calibration.js",
      "default": "./dist/instagram-calibration.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node ../../tools/typecheck-release.mjs --emit --project tsconfig.json",
    "typecheck": "node ../../tools/typecheck-release.mjs --project tsconfig.json",
    "test": "node --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "typecheck:local": "node ../../tools/typecheck-local.mjs --project tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "24.13.3"
  }
}
