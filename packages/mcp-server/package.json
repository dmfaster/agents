{
  "name": "@dmfaster/mcp-server",
  "version": "1.11.0",
  "description": "DM Faster prospecting and sales tools with company and saved-list mentions and an interactive workspace.",
  "license": "Apache-2.0",
  "author": "DM Faster",
  "homepage": "https://dmfaster.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmfaster/agents.git",
    "directory": "packages/mcp-server"
  },
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "bin": {
    "dmfaster-mcp": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "generate:ui": "node tools/build-campaign-workspace-ui.mjs",
    "build": "npm run generate:ui && tsc -p tsconfig.json",
    "typecheck": "npm run generate:ui && tsc -p ui/tsconfig.json --noEmit && tsc -p tsconfig.json --noEmit",
    "test": "npm run generate:ui && node --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@dmfaster/local-auth": "1.11.0",
    "@dmfaster/sdk": "1.11.0",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@dmfaster/product-ui": "0.1.0",
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.25.12",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "exports": {
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    }
  }
}
