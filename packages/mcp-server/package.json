{
  "name": "@dmfaster/mcp-server",
  "version": "2.7.1",
  "description": "DM Faster prospecting and sales tools with company and saved-list mentions and an interactive workspace.",
  "license": "Apache-2.0",
  "author": "DM Faster",
  "homepage": "https://dmfaster.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmfaster/agents.git",
    "directory": "packages/mcp-server"
  },
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "bin": {
    "dmfaster-mcp": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "generate:ui": "node tools/build-campaign-workspace-ui.mjs",
    "build": "npm run generate:ui && node ../../tools/typecheck-release.mjs --emit --project tsconfig.json",
    "typecheck": "npm run generate:ui && node ../../tools/typecheck-release.mjs --project ui/tsconfig.json && node ../../tools/typecheck-release.mjs --project tsconfig.json",
    "test": "npm run generate:ui && node --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "typecheck:local": "npm run generate:ui && node ../../tools/typecheck-local.mjs --project ui/tsconfig.json && node ../../tools/typecheck-local.mjs --project tsconfig.json",
    "test:built": "node --test tests/*.test.ts",
    "typecheck:ui": "node ../../tools/typecheck-release.mjs --project ui/tsconfig.json",
    "typecheck:ui:local": "node ../../tools/typecheck-local.mjs --project ui/tsconfig.json"
  },
  "dependencies": {
    "@dmfaster/local-auth": "2.7.1",
    "@dmfaster/sdk": "2.7.1",
    "@modelcontextprotocol/server": "2.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@dmfaster/product-ui": "0.1.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.25.12",
    "lucide-react": "1.27.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3"
  },
  "exports": {
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    }
  }
}
