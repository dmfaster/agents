{
  "name": "@dmfaster/mcp-server",
  "version": "2.9.0",
  "description": "Headless DM Faster prospecting and sales tools with scoped discovery and typed domain operations.",
  "license": "Apache-2.0",
  "author": "DM Faster",
  "homepage": "https://dmfaster.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmfaster/agents.git",
    "directory": "packages/mcp-server"
  },
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "bin": {
    "dmfaster-mcp": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && node ../../tools/typecheck-release.mjs --emit --project tsconfig.json",
    "typecheck": "node ../../tools/typecheck-release.mjs --project tsconfig.json",
    "test": "node --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "typecheck:local": "node ../../tools/typecheck-local.mjs --project tsconfig.json",
    "test:built": "node --test tests/*.test.ts"
  },
  "dependencies": {
    "@dmfaster/local-auth": "2.9.0",
    "@dmfaster/sdk": "2.9.0",
    "@modelcontextprotocol/server": "2.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.13.3"
  },
  "exports": {
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    }
  }
}
