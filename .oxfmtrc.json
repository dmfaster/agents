{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/node_modules/**",
    "**/.next*/**",
    "**/.vercel/**",
    "**/.eve/**",
    "**/.output/**",
    "**/.cache/**",
    "**/outputs/**",
    "**/data/**",
    "**/src/lib/generated/**",
    "**/next-env.d.ts",
    "**/test-results/**",
    "**/playwright-report/**",
    "worker-runtime/**",
    "content.js",
    "background.js",
    "worker-protocol.generated.js",
    ".github/disabled-workflows/**",
    "pnpm-lock.yaml",
    "**/package-lock.json",
    "tools/fixtures/**"
  ]
}
